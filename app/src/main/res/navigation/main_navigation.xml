<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/searchFragment">

<!-- Search Flow -->
    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.hirelink_2025.ui.fragments.search.SearchFragment"
        android:label="@string/nav_search">

        <action
            android:id="@+id/action_searchFragment_to_searchResultListFragment"
            app:destination="@id/searchResultListFragment"
            app:enterAnim="@anim/fade_in"
            app:exitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/searchResultListFragment"
        android:name="com.example.hirelink_2025.ui.fragments.search.SearchResultListFragment"
        android:label="@string/results">
        <action
            android:id="@+id/action_searchResultListFragment_to_jobDescriptionDetailFragment"
            app:destination="@id/jobDescriptionDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />
        <action
            android:id="@+id/action_searchResultListFragment_to_searchFilterMenuFragment"
            app:destination="@id/searchFilterMenuFragment"
            app:enterAnim="@anim/slide_in_bottom"
            app:exitAnim="@anim/fade_out" />
    </fragment>

    <fragment
        android:id="@+id/searchFilterMenuFragment"
        android:name="com.example.hirelink_2025.ui.fragments.search.SearchFilterMenuFragment"
        android:label="@string/filters">
        <action
            android:id="@+id/action_searchFilterMenuFragment_to_searchFilterDetailFragment"
            app:destination="@id/searchFilterDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left" />
    </fragment>

    <fragment
        android:id="@+id/searchFilterDetailFragment"
        android:name="com.example.hirelink_2025.ui.fragments.search.SearchFilterDetailFragment"
        android:label="Filter" />

    <fragment
        android:id="@+id/jobDescriptionDetailFragment"
        android:name="com.example.hirelink_2025.ui.fragments.common.JobDescriptionDetailFragment"
        android:label="Job Details">
        <action
            android:id="@+id/action_jobDescriptionDetailFragment_to_jobLocationDetailDialog"
            app:destination="@id/jobLocationDetailDialog" />
    </fragment>

    <dialog
        android:id="@+id/jobLocationDetailDialog"
        android:name="com.example.hirelink_2025.ui.dialogs.JobLocationDetailDialog"
        android:label="Location" />

    <!-- My Applications -->
    <fragment
        android:id="@+id/myApplicationsFragment"
        android:name="com.example.hirelink_2025.ui.fragments.applications.MyApplicationsFragment"
        android:label="@string/nav_applications">

        <action
            android:id="@+id/action_myApplicationsFragment_to_applicationDetailFragment"
            app:destination="@id/applicationDetailFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right" />

    </fragment>

    <!-- NUEVO FRAGMENT - Agregar al final antes de </navigation> -->


    <fragment
        android:id="@+id/applicationDetailFragment"
        android:name="com.example.hirelink_2025.ui.fragments.applications.ApplicationDetailFragment"
        android:label="Detalles de Postulación"
        tools:layout="@layout/fragment_application_detail" />
    <!-- My Ads Flow -->
    <fragment
        android:id="@+id/myAdsFragment"
        android:name="com.example.hirelink_2025.ui.fragments.ads.MyAdsFragment"
        android:label="@string/nav_my_ads">
        <action
            android:id="@+id/action_myAdsFragment_to_myAdsRegisterFragment"
            app:destination="@id/myAdsRegisterFragment" />
        <action
            android:id="@+id/action_myAdsFragment_to_myAdsEditFragment"
            app:destination="@id/myAdsEditFragment" />
        <action
            android:id="@+id/action_myAdsFragment_to_myAdsApplicantsFragment"
            app:destination="@id/myAdsApplicantsFragment" />
        <action
            android:id="@+id/action_myAdsFragment_to_myAdDetailFragment"
            app:destination="@id/myAdDetailFragment" />

    </fragment>

    <fragment
        android:id="@+id/myAdsRegisterFragment"
        android:name="com.example.hirelink_2025.ui.fragments.ads.MyAdsRegisterFragment"
        android:label="@string/new_ad">
        <action
            android:id="@+id/action_myAdsRegisterFragment_to_editLocationFragment"
            app:destination="@id/editLocationFragment" />
    </fragment>

    <fragment
        android:id="@+id/myAdsEditFragment"
        android:name="com.example.hirelink_2025.ui.fragments.ads.MyAdsEditFragment"
        android:label="@string/edit_job">
        <action
            android:id="@+id/action_myAdsEditFragment_to_editLocationFragment"
            app:destination="@id/editLocationFragment" />
    </fragment>

    <fragment
        android:id="@+id/myAdDetailFragment"
        android:name="com.example.hirelink_2025.ui.fragments.ads.MyAdDetailFragment"
        android:label="Detalles del Anuncio"
        tools:layout="@layout/fragment_my_ad_detail">

        <action
            android:id="@+id/action_myAdDetailFragment_to_myAdsEditFragment"
            app:destination="@id/myAdsEditFragment" />

        <action
            android:id="@+id/action_myAdDetailFragment_to_myAdsApplicantsFragment"
            app:destination="@id/myAdsApplicantsFragment" />

    </fragment>

    <fragment
        android:id="@+id/editLocationFragment"
        android:name="com.example.hirelink_2025.ui.fragments.ads.EditLocationFragment"
        android:label="@string/location" />

    <fragment
        android:id="@+id/myAdsApplicantsFragment"
        android:name="com.example.hirelink_2025.ui.fragments.ads.MyAdsApplicantsFragment"
        android:label="Aplicantes"
        tools:layout="@layout/fragment_my_ads_applicants">

        <action
            android:id="@+id/action_myAdsApplicantsFragment_to_profileFragment"
            app:destination="@id/profileViewFragment" />
        <action
            android:id="@+id/action_myAdsApplicantsFragment_to_applicantProfileFragment"
            app:destination="@id/applicantProfileFragment" />

        <!-- En nav_graph.xml, dentro del fragment myAdsApplicantsFragment -->
    </fragment>

    <!-- Agregar este nuevo fragment al final del archivo, antes de </navigation> -->
    <!-- AGREGAR ESTE DESTINO -->
    <fragment
        android:id="@+id/applicantProfileFragment"
        android:name="com.example.hirelink_2025.ui.fragments.applications.ApplicantProfileFragment"
        android:label="Perfil del Aplicante"
        tools:layout="@layout/fragment_applicant_profile">

        <argument
            android:name="applicant_id"
            app:argType="string" />
        <argument
            android:name="applicant_name"
            app:argType="string" />
        <argument
            android:name="applicant_email"
            app:argType="string" />
        <argument
            android:name="applicant_phone"
            app:argType="string" />
        <argument
            android:name="applicant_profession"
            app:argType="string" />
        <argument
            android:name="applicant_experience"
            app:argType="string" />
        <argument
            android:name="applicant_skills"
            app:argType="string[]" />
        <argument
            android:name="application_date"
            app:argType="string" />
        <argument
            android:name="application_status"
            app:argType="string" />
        <argument
            android:name="profile_image"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="job_id"
            app:argType="string" />
        <argument
            android:name="cover_letter"
            app:argType="string" />

    </fragment>

    <fragment
        android:id="@+id/profileViewFragment"
        android:name="com.example.hirelink_2025.ui.fragments.profile.ProfileViewFragment"
        android:label="Profile" />

    <!-- Profile -->
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.hirelink_2025.ui.fragments.profile.ProfileFragment"
        android:label="@string/nav_profile">
        <action
            android:id="@+id/action_profileFragment_to_profileEditFragment"
            app:destination="@id/profileEditFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileEditFragment"
        android:name="com.example.hirelink_2025.ui.fragments.profile.ProfileEditFragment"
        android:label="@string/edit_profile">
        <action
            android:id="@+id/action_profileEditFragment_to_profileEditExperienceAddFragment"
            app:destination="@id/profileEditExperienceAddFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileEditExperienceAddFragment"
        android:name="com.example.hirelink_2025.ui.fragments.profile.ProfileEditExperienceAddFragment"
        android:label="@string/add_experience" />

    <!-- Fragment de empleos existente -->
    <fragment
        android:id="@+id/jobsFragment"
        android:name="com.example.hirelink_2025.ui.fragments.JobsFragment"
        android:label="Empleos"
        tools:layout="@layout/fragment_jobs">

        <action
            android:id="@+id/action_jobsFragment_to_jobDetailFragment"
            app:destination="@id/jobDetailFragment" />
    </fragment>

    <!-- NUEVO: Fragment de detalles del empleo -->
    <fragment
        android:id="@+id/jobDetailFragment"
        android:name="com.example.hirelink_2025.ui.fragments.JobDetailFragment"
        android:label="Detalles del Empleo"
        tools:layout="@layout/fragment_job_detail">

        <argument
            android:name="jobId"
            app:argType="string" />
    </fragment>

</navigation>