<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header with gradient -->
        <View
            android:id="@+id/headerGradient"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/gradient_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/toolbar" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/transparent"
            android:elevation="0dp"
            app:navigationIcon="@drawable/ic_close"
            app:navigationIconTint="@color/white"
            app:title="@string/new_ad"
            app:titleTextColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Main Content Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mainContentCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_medium"
            android:layout_marginTop="@dimen/margin_small"
            app:cardCornerRadius="@dimen/radius_extra_large"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_large">

                <!-- Company Selection Section -->
                <TextView
                    style="@style/TextAppearance.HireLink.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seleccionar Compañía"
                    android:textColor="@color/primary"
                    android:drawableStart="@drawable/ic_group"
                    android:drawableTint="@color/primary"
                    android:drawablePadding="@dimen/margin_small"
                    android:gravity="center_vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:background="@color/divider" />

                <!-- Company Selector -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/companySelectInputLayout"
                    style="@style/Widget.HireLink.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:hint="Selecciona tu compañía"
                    app:startIconDrawable="@drawable/ic_group"
                    app:startIconTint="@color/secondary"
                    app:endIconMode="dropdown_menu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/companySelectDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="8dp"
                        android:importantForAccessibility="yes"
                        android:inputType="none"
                        android:focusable="false"
                        android:clickable="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Auto-fill Notice -->
                <LinearLayout
                    android:id="@+id/autoFillNoticeLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:orientation="horizontal"
                    android:padding="@dimen/margin_small"
                    android:background="@drawable/chip_background"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:src="@drawable/ic_info"
                        app:tint="@color/primary" />

                    <TextView
                        style="@style/TextAppearance.HireLink.Caption"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Los campos de empresa se completarán automáticamente"
                        android:textColor="@color/primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/clearSelectionButton"
                        style="@style/Widget.Material3.Button.IconButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/ic_close"
                        app:iconTint="@color/text_hint"
                        app:iconSize="16dp" />

                </LinearLayout>

                <!-- Job Information Section -->
                <TextView
                    style="@style/TextAppearance.HireLink.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/job_information"
                    android:textColor="@color/primary"
                    android:drawableStart="@drawable/ic_work"
                    android:drawableTint="@color/primary"
                    android:drawablePadding="@dimen/margin_small"
                    android:gravity="center_vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:background="@color/divider" />

                <!-- Title Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/titleInputLayout"
                    style="@style/Widget.HireLink.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Puesto"
                    app:startIconDrawable="@drawable/ic_title"
                    app:startIconTint="@color/secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/titleEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <!--CAMPOS NO CONFIGURADOS-->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/nameCompanyLayout"
                    style="@style/Widget.HireLink.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Nombre de la empresa"
                    app:startIconDrawable="@drawable/ic_vacation"
                    app:startIconTint="@color/secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nameCompany"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLines="2" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- About Company Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/aboutCompanyInputLayout"
                    style="@style/Widget.HireLink.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:hint="Descripción"
                    app:startIconDrawable="@drawable/ic_info"
                    app:startIconTint="@color/secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/aboutCompanyEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:maxLines="5" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- About Job Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/aboutJobInputLayout"
                    style="@style/Widget.HireLink.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:hint="Acerca del empleo"
                    app:startIconDrawable="@drawable/ic_description"
                    app:startIconTint="@color/secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/aboutJobEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:maxLines="5" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Required Skills Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/skillsInputLayout"
                    style="@style/Widget.HireLink.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:hint="Requisitos"
                    app:startIconDrawable="@drawable/ic_skill"
                    app:startIconTint="@color/secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/skillsEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:maxLines="5" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Job Details Section -->
                <TextView
                    style="@style/TextAppearance.HireLink.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_extra_large"
                    android:text="@string/job_detail"
                    android:textColor="@color/primary"
                    android:drawableStart="@drawable/ic_info"
                    android:drawableTint="@color/primary"
                    android:drawablePadding="@dimen/margin_small"
                    android:gravity="center_vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:background="@color/divider" />

                <!-- Vacancies and Employment Type Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/vacanciesInputLayout"
                        style="@style/Widget.HireLink.TextInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:hint="@string/vacancies"
                        app:startIconDrawable="@drawable/ic_people"
                        app:startIconTint="@color/secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/vacanciesEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/employmentTypeInputLayout"
                        style="@style/Widget.HireLink.TextInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/margin_small"
                        android:hint="Horario Laboral"
                        app:startIconDrawable="@drawable/ic_work_small"
                        app:startIconTint="@color/secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/employmentTypeEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- Modality Dropdown -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/modalityInputLayout"
                    style="@style/Widget.HireLink.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:hint="@string/modality"
                    app:startIconDrawable="@drawable/ic_modality"
                    app:startIconTint="@color/secondary"
                    app:endIconMode="dropdown_menu">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/modalityDropdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingVertical="8dp"
                        android:importantForAccessibility="yes"
                        android:contentDescription="@string/select_modality"
                        android:inputType="none"
                        android:focusable="false"
                        android:clickable="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Date and Position Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/dateInputLayout"
                        style="@style/Widget.HireLink.TextInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:hint="Fecha Límite"
                        app:startIconDrawable="@drawable/ic_schedule"
                        app:startIconTint="@color/secondary"
                        app:endIconMode="custom"
                        app:endIconDrawable="@drawable/ic_calendar"
                        app:endIconTint="@color/text_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/dateEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:focusable="false"
                            android:clickable="true" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/ofertInputLayout"
                        style="@style/Widget.HireLink.TextInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/margin_small"
                        android:hint="Oferta"
                        app:startIconDrawable="@drawable/ic_money"
                        app:startIconTint="@color/secondary">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/positionEditText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>


                <!-- Contact Info Section -->
                <TextView
                    style="@style/TextAppearance.HireLink.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_extra_large"
                    android:text="@string/contact"
                    android:textColor="@color/primary"
                    android:drawableStart="@drawable/ic_phone"
                    android:drawableTint="@color/primary"
                    android:drawablePadding="@dimen/margin_small"
                    android:gravity="center_vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:background="@color/divider" />

                <!-- Phone Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/phoneInputLayout"
                    style="@style/Widget.HireLink.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/phone"
                    app:prefixText="+51"
                    app:startIconDrawable="@drawable/ic_phone"
                    app:startIconTint="@color/secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/phoneEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:maxLength="9" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailInputLayout"
                    style="@style/Widget.HireLink.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:hint="@string/email"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="@color/secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Website Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/websiteInputLayout"
                    style="@style/Widget.HireLink.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:hint="@string/website"
                    app:startIconDrawable="@drawable/ic_web"
                    app:startIconTint="@color/secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/websiteEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri" />

                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Publish Button Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_medium"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginBottom="@dimen/margin_large"
            app:cardCornerRadius="@dimen/radius_extra_large"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/mainContentCard">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/publishButton"
                style="@style/Widget.HireLink.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/margin_medium"
                android:minHeight="@dimen/button_height"
                android:text="@string/publish_ad"
                android:textSize="@dimen/text_size_medium"
                app:icon="@drawable/ic_publish"
                app:iconGravity="textStart"
                app:backgroundTint="@color/primary"
                app:cornerRadius="@dimen/radius_large" />

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>