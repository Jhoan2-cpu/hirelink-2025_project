<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/jobCard"
    style="@style/Widget.HireLink.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/margin_small"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="2dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/margin_medium">

        <!-- Company Logo -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/logoCard"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:cardCornerRadius="@dimen/radius_medium"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/companyLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/margin_small"
                android:src="@drawable/ic_launcher_foreground"
                android:scaleType="centerInside" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Job Title -->
        <TextView
            android:id="@+id/jobTitle"
            style="@style/TextAppearance.HireLink.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_medium"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            app:layout_constraintEnd_toStartOf="@id/bookmarkButton"
            app:layout_constraintStart_toEndOf="@id/logoCard"
            app:layout_constraintTop_toTopOf="@id/logoCard"
            tools:text="Desarrollador Android Senior" />

        <!-- Company Name -->
        <TextView
            android:id="@+id/companyName"
            style="@style/TextAppearance.HireLink.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_tiny"
            android:textColor="@color/text_secondary"
            app:layout_constraintEnd_toStartOf="@id/bookmarkButton"
            app:layout_constraintStart_toStartOf="@id/jobTitle"
            app:layout_constraintTop_toBottomOf="@id/jobTitle"
            tools:text="Tech Solutions S.A.C." />

        <!-- Bookmark Button #####ELIMINR EL BOTÓN DE GUARDAR-->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/bookmarkButton"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_bookmark_border"
            app:iconTint="@color/text_secondary"
            android:visibility="invisible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:text="Save"/>

        <!-- Info Chips -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/infoChipGroup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            app:chipSpacingHorizontal="@dimen/margin_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/logoCard">

            <com.google.android.material.chip.Chip
                android:id="@+id/locationChip"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:textSize="@dimen/text_size_small"
                app:chipIcon="@drawable/ic_location_small"
                app:chipIconSize="16dp"
                app:chipMinHeight="32dp"
                tools:text="Lima, Perú" />

            <com.google.android.material.chip.Chip
                android:id="@+id/modalityChip"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:textSize="@dimen/text_size_small"
                app:chipIcon="@drawable/ic_work_small"
                app:chipIconSize="16dp"
                app:chipMinHeight="32dp"
                tools:text="Remoto" />

            <com.google.android.material.chip.Chip
                android:id="@+id/salaryChip"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:textSize="@dimen/text_size_small"
                app:chipIcon="@drawable/ic_money"
                app:chipIconSize="16dp"
                app:chipMinHeight="32dp"
                tools:text="S/. 5000 - 7000" />

        </com.google.android.material.chip.ChipGroup>

        <!-- Posted Date and Apply Button -->
        <TextView
            android:id="@+id/postedDate"
            style="@style/TextAppearance.HireLink.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_medium"
            android:textColor="@color/text_secondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/infoChipGroup"
            tools:text="Hace 2 días" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/applyButton"
            style="@style/Widget.HireLink.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="@string/apply"
            android:textSize="@dimen/text_size_small"
            app:layout_constraintBottom_toBottomOf="@id/postedDate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/postedDate" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>