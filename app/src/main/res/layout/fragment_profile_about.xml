<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="@dimen/margin_large"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Nombre completo -->
        <TextView
            android:id="@+id/fullNameTextView"
            style="@style/TextAppearance.HireLink.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre del Usuario"
            android:textColor="@color/text_primary" />

        <!-- Especialidad -->
        <TextView
            android:id="@+id/specialtyTextView"
            style="@style/TextAppearance.HireLink.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:text="Especialidad: Android Developer"
            android:textColor="@color/text_secondary" />

        <!-- Ciudad o país -->
        <TextView
            android:id="@+id/locationTextView"
            style="@style/TextAppearance.HireLink.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lima, Perú"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="@dimen/margin_small" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/margin_medium"
            android:background="@color/divider" />

        <!-- Biografía -->
        <TextView
            android:id="@+id/bioTitle"
            style="@style/TextAppearance.HireLink.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/about_me"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/bioTextView"
            style="@style/TextAppearance.HireLink.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_small"
            android:text="Soy un desarrollador apasionado por crear aplicaciones móviles útiles y de alto rendimiento." />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/margin_medium"
            android:background="@color/divider" />

        <!-- Enlaces -->
        <TextView
            android:id="@+id/linksTitle"
            style="@style/TextAppearance.HireLink.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Redes / Portafolio"
            android:textColor="@color/text_primary" />

        <!-- Sitio web -->
        <TextView
            android:id="@+id/websiteTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:text="https://portafolioejemplo.com"
            android:textColor="@color/primary"
            android:layout_marginTop="@dimen/margin_small" />

        <!-- LinkedIn -->
        <TextView
            android:id="@+id/linkedinTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:text="https://linkedin.com/in/usuario"
            android:textColor="@color/primary"
            android:layout_marginTop="@dimen/margin_small" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
