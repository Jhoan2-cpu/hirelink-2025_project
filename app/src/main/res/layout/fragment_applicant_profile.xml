<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="4dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/text_primary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/toolbarTitle"
                style="@style/TextAppearance.HireLink.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Perfil del Postulante"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/shareButton"
                app:layout_constraintStart_toEndOf="@id/backButton"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/text_primary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_medium">

            <!-- Profile Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_large">

                    <!-- Profile Photo and Basic Info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            app:cardCornerRadius="50dp"
                            app:cardElevation="@dimen/card_elevation"
                            app:cardBackgroundColor="@color/surface_variant">

                            <ImageView
                                android:id="@+id/applicantPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/ic_person"
                                android:scaleType="centerCrop"
                                android:contentDescription="Foto de perfil del postulante" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_large"
                            android:orientation="vertical">

                            <!-- Applicant Name -->
                            <TextView
                                android:id="@+id/applicantName"
                                style="@style/TextAppearance.HireLink.Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                tools:text="Juan Carlos Pérez" />

                            <!-- Applicant Profession -->
                            <TextView
                                android:id="@+id/applicantProfession"
                                style="@style/TextAppearance.HireLink.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_tiny"
                                android:textColor="@color/text_secondary"
                                android:textSize="16sp"
                                tools:text="Desarrollador Android Senior" />

                            <!-- Experience Years -->
                            <TextView
                                android:id="@+id/experienceYears"
                                style="@style/TextAppearance.HireLink.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_small"
                                android:textColor="@color/text_hint"
                                android:drawableStart="@drawable/ic_work_small"
                                android:drawableTint="@color/text_hint"
                                android:drawablePadding="@dimen/margin_tiny"
                                android:gravity="center_vertical"
                                tools:text="5 años de experiencia" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Status Chip -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/statusChip"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:chipIcon="@drawable/ic_pending"
                        app:chipIconSize="16dp"
                        tools:text="Pendiente" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Contact Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_large">

                    <TextView
                        style="@style/TextAppearance.HireLink.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Información de Contacto"
                        android:textColor="@color/primary"
                        android:drawableStart="@drawable/ic_phone"
                        android:drawableTint="@color/primary"
                        android:drawablePadding="@dimen/margin_small"
                        android:gravity="center_vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/margin_small"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:background="@color/divider" />

                    <!-- Email -->
                    <LinearLayout
                        android:id="@+id/emailLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/margin_small"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:padding="@dimen/margin_small">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:src="@drawable/ic_email"
                            app:tint="@color/secondary" />

                        <TextView
                            android:id="@+id/applicantEmail"
                            style="@style/TextAppearance.HireLink.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/info"
                            tools:text="juan.perez@email.com" />

                    </LinearLayout>

                    <!-- Phone -->
                    <LinearLayout
                        android:id="@+id/phoneLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:padding="@dimen/margin_small">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/secondary" />

                        <TextView
                            android:id="@+id/applicantPhone"
                            style="@style/TextAppearance.HireLink.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/info"
                            tools:text="+51 987654321" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Experience and Skills Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_large">

                    <!-- Experience Section -->
                    <TextView
                        style="@style/TextAppearance.HireLink.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Experiencia Profesional"
                        android:textColor="@color/primary"
                        android:drawableStart="@drawable/ic_work"
                        android:drawableTint="@color/primary"
                        android:drawablePadding="@dimen/margin_small"
                        android:gravity="center_vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/margin_small"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/applicantExperience"
                        style="@style/TextAppearance.HireLink.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_large"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        tools:text="5 años de experiencia en desarrollo móvil con especialización en Android. He trabajado en equipos ágiles desarrollando aplicaciones nativas." />

                    <!-- Skills Section -->
                    <TextView
                        style="@style/TextAppearance.HireLink.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Habilidades Técnicas"
                        android:textColor="@color/primary"
                        android:drawableStart="@drawable/ic_skill"
                        android:drawableTint="@color/primary"
                        android:drawablePadding="@dimen/margin_small"
                        android:gravity="center_vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/margin_small"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:background="@color/divider" />

                    <!-- Skills Chip Group -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/skillsChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="@dimen/margin_small">

                        <!-- Skills will be added programmatically -->

                    </com.google.android.material.chip.ChipGroup>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Additional Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="80dp"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_large">

                    <TextView
                        style="@style/TextAppearance.HireLink.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Información Adicional"
                        android:textColor="@color/primary"
                        android:drawableStart="@drawable/ic_info"
                        android:drawableTint="@color/primary"
                        android:drawablePadding="@dimen/margin_small"
                        android:gravity="center_vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/margin_small"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:background="@color/divider" />

                    <!-- Location -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/margin_small">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:src="@drawable/ic_location"
                            app:tint="@color/text_secondary" />

                        <TextView
                            android:id="@+id/applicantLocation"
                            style="@style/TextAppearance.HireLink.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            tools:text="Lima, Perú" />

                    </LinearLayout>

                    <!-- Bio -->
                    <TextView
                        android:id="@+id/applicantBio"
                        style="@style/TextAppearance.HireLink.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        tools:text="Desarrollador apasionado por crear soluciones innovadoras..." />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="10dp"
        >

        <!-- Línea separadora -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider"
            android:layout_marginBottom="@dimen/margin_medium" />

        <!-- Primary Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/acceptButton"
                style="@style/Widget.HireLink.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/margin_small"
                android:text="Aceptar"
                android:textSize="@dimen/text_size_medium"
                app:icon="@drawable/ic_check"
                app:iconGravity="textStart"
                app:backgroundTint="@color/success"
                app:cornerRadius="@dimen/radius_large" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/rejectButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/margin_small"
                android:text="Rechazar"
                android:textSize="@dimen/text_size_medium"
                android:textColor="@color/error"
                app:icon="@drawable/ic_close"
                app:iconGravity="textStart"
                app:iconTint="@color/error"
                app:strokeColor="@color/error"
                app:cornerRadius="@dimen/radius_large" />

        </LinearLayout>


    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>