<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Header with gradient -->
        <View
            android:id="@+id/headerGradient"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:background="@drawable/gradient_background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/transparent"
            android:elevation="0dp"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/white"
            app:title="Detalles de la Compañía"
            app:titleTextColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Company Logo and Basic Info -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/companyHeaderCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_medium"
            android:layout_marginTop="80dp"
            app:cardCornerRadius="@dimen/radius_extra_large"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/headerGradient">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_large"
                android:gravity="center_horizontal">

                <!-- Company Logo -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/logoCard"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:cardCornerRadius="@dimen/radius_large"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="@color/surface_variant">

                    <ImageView
                        android:id="@+id/companyLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/margin_medium"
                        android:src="@drawable/ic_group"
                        android:scaleType="centerInside"
                        app:tint="@color/primary" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Company Name -->
                <TextView
                    android:id="@+id/companyName"
                    style="@style/TextAppearance.HireLink.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    android:textColor="@color/text_primary"
                    android:gravity="center"
                    tools:text="TechSolutions S.A.C." />

                <!-- Company Type -->
                <TextView
                    android:id="@+id/companyType"
                    style="@style/TextAppearance.HireLink.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_small"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    tools:text="Tecnología • Lima, Perú" />

                <!-- Stats Chips -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/statsChipGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_medium"
                    app:chipSpacingHorizontal="@dimen/margin_small">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/employeeCountChip"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipIcon="@drawable/ic_people"
                        app:chipIconSize="16dp"
                        tools:text="75 empleados" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/activeJobsChip"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipIcon="@drawable/ic_work_small"
                        app:chipIconSize="16dp"
                        tools:text="3 empleos activos" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/foundedYearChip"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipIcon="@drawable/ic_calendar"
                        app:chipIconSize="16dp"
                        tools:text="Fundada en 2020" />

                </com.google.android.material.chip.ChipGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Company Description Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/descriptionCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_medium"
            android:layout_marginTop="@dimen/margin_medium"
            app:cardCornerRadius="@dimen/radius_extra_large"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/companyHeaderCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_large">

                <TextView
                    style="@style/TextAppearance.HireLink.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Descripción"
                    android:textColor="@color/primary"
                    android:drawableStart="@drawable/ic_description"
                    android:drawableTint="@color/primary"
                    android:drawablePadding="@dimen/margin_small"
                    android:gravity="center_vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:background="@color/divider" />

                <TextView
                    android:id="@+id/companyDescription"
                    style="@style/TextAppearance.HireLink.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="4dp"
                    tools:text="Empresa líder en desarrollo de software y soluciones tecnológicas innovadoras para el mercado peruano y latinoamericano." />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Location Information Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/locationCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_medium"
            android:layout_marginTop="@dimen/margin_medium"
            app:cardCornerRadius="@dimen/radius_extra_large"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/descriptionCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_large">

                <TextView
                    style="@style/TextAppearance.HireLink.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ubicación"
                    android:textColor="@color/primary"
                    android:drawableStart="@drawable/ic_location"
                    android:drawableTint="@color/primary"
                    android:drawablePadding="@dimen/margin_small"
                    android:gravity="center_vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:background="@color/divider" />

                <!-- Address -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/margin_small">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:src="@drawable/ic_location_on"
                        app:tint="@color/secondary" />

                    <TextView
                        android:id="@+id/companyAddress"
                        style="@style/TextAppearance.HireLink.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        tools:text="Av. Javier Prado Este 123, Lima, Perú" />

                </LinearLayout>

                <!-- City and Country -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:src="@drawable/ic_location_small"
                        app:tint="@color/secondary" />

                    <TextView
                        android:id="@+id/companyCityCountry"
                        style="@style/TextAppearance.HireLink.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_primary"
                        tools:text="Lima, Perú" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Contact Information Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/contactCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_medium"
            android:layout_marginTop="@dimen/margin_medium"
            app:cardCornerRadius="@dimen/radius_extra_large"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/locationCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_large">

                <TextView
                    style="@style/TextAppearance.HireLink.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Información de Contacto"
                    android:textColor="@color/primary"
                    android:drawableStart="@drawable/ic_phone"
                    android:drawableTint="@color/primary"
                    android:drawablePadding="@dimen/margin_small"
                    android:gravity="center_vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:background="@color/divider" />

                <!-- Phone -->
                <LinearLayout
                    android:id="@+id/phoneLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/margin_small">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/secondary" />

                    <TextView
                        android:id="@+id/companyPhone"
                        style="@style/TextAppearance.HireLink.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/blue_contact"
                        tools:text="+51 987654321" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_link"
                        app:tint="@color/text_hint" />

                </LinearLayout>

                <!-- Email -->
                <LinearLayout
                    android:id="@+id/emailLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/margin_small">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:src="@drawable/ic_email"
                        app:tint="@color/secondary" />

                    <TextView
                        android:id="@+id/companyEmail"
                        style="@style/TextAppearance.HireLink.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/blue_contact"
                        tools:text="info@techsolutions.com" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_link"
                        app:tint="@color/text_hint" />

                </LinearLayout>

                <!-- Website -->
                <LinearLayout
                    android:id="@+id/websiteLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground"
                    android:padding="@dimen/margin_small">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:src="@drawable/ic_web"
                        app:tint="@color/secondary" />

                    <TextView
                        android:id="@+id/companyWebsite"
                        style="@style/TextAppearance.HireLink.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/blue_contact"
                        tools:text="www.techsolutions.com" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_link"
                        app:tint="@color/text_hint" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/margin_medium"
            android:layout_marginTop="@dimen/margin_medium"
            android:layout_marginBottom="@dimen/margin_large"
            app:cardCornerRadius="@dimen/radius_extra_large"
            app:cardElevation="@dimen/card_elevation"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contactCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_large">

                <TextView
                    style="@style/TextAppearance.HireLink.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Acciones"
                    android:textColor="@color/primary"
                    android:drawableStart="@drawable/ic_settings"
                    android:drawableTint="@color/primary"
                    android:drawablePadding="@dimen/margin_small"
                    android:gravity="center_vertical" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/margin_small"
                    android:layout_marginBottom="@dimen/margin_medium"
                    android:background="@color/divider" />

                <!-- Buttons Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/editCompanyButton"
                        style="@style/Widget.HireLink.Button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/margin_small"
                        android:text="Editar"
                        android:textSize="@dimen/text_size_medium"
                        app:icon="@drawable/ic_edit"
                        app:iconGravity="textStart"
                        app:backgroundTint="@color/primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/deleteCompanyButton"
                        style="@style/Widget.HireLink.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/margin_small"
                        android:text="Eliminar"
                        android:textSize="@dimen/text_size_medium"
                        android:textColor="@color/error"
                        app:icon="@drawable/ic_delete"
                        app:iconGravity="textStart"
                        app:iconTint="@color/error"
                        app:strokeColor="@color/error" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>