<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_filter_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Filtro por modalidad -->
        <!-- Filtro por modalidad -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/modalityInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Modalidad"
            app:endIconMode="dropdown_menu"
            android:importantForAccessibility="yes">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/modalityDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:inputType="none"
                android:focusable="true"
                android:cursorVisible="false"
                android:clickable="true"
                android:longClickable="false"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />
        </com.google.android.material.textfield.TextInputLayout>



        <!-- Otro ejemplo de filtro (país, por ejemplo) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/countryInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginBottom="16dp"
            android:hint="País"
            app:endIconMode="dropdown_menu">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/countryDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:inputType="none"
                android:cursorVisible="false"
                android:clickable="true"
                android:longClickable="false"
                android:importantForAccessibility="no"
                android:focusable="false" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón de aplicar filtros -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/applyFilterButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aplicar filtros"
            android:layout_marginTop="24dp" />

    </LinearLayout>
</ScrollView>
