<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="4dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_scrollFlags="scroll|enterAlways|snap">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/text_primary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/toolbarTitle"
                style="@style/TextAppearance.HireLink.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Detalles de Postulación"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/shareButton"
                app:layout_constraintStart_toEndOf="@id/backButton"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shareButton"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:icon="@drawable/ic_share"
                app:iconTint="@color/text_primary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/margin_medium">

            <!-- Application Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_large">

                    <!-- Company Logo and Basic Info -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            app:cardCornerRadius="@dimen/radius_medium"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="@color/surface_variant">

                            <ImageView
                                android:id="@+id/companyLogo"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:padding="@dimen/margin_small"
                                android:src="@drawable/ic_group"
                                android:scaleType="centerInside"
                                app:tint="@color/primary" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/margin_medium"
                            android:orientation="vertical">

                            <!-- Job Title -->
                            <TextView
                                android:id="@+id/jobTitle"
                                style="@style/TextAppearance.HireLink.Title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="Desarrollador Android Senior" />

                            <!-- Company Name -->
                            <TextView
                                android:id="@+id/companyName"
                                style="@style/TextAppearance.HireLink.Body"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_tiny"
                                android:textColor="@color/text_secondary"
                                tools:text="TechSolutions S.A.C." />

                            <!-- Application Date -->
                            <TextView
                                android:id="@+id/applicationDate"
                                style="@style/TextAppearance.HireLink.Caption"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_tiny"
                                android:textColor="@color/text_hint"
                                android:drawableStart="@drawable/ic_calendar"
                                android:drawableTint="@color/text_hint"
                                android:drawablePadding="@dimen/margin_tiny"
                                android:gravity="center_vertical"
                                tools:text="Postulado hace 3 días" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Application Status Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_large">

                    <TextView
                        style="@style/TextAppearance.HireLink.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estado de la Postulación"
                        android:textColor="@color/primary"
                        android:drawableStart="@drawable/ic_analytics"
                        android:drawableTint="@color/primary"
                        android:drawablePadding="@dimen/margin_small"
                        android:gravity="center_vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/margin_small"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:background="@color/divider" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/statusChip"
                        style="@style/Widget.Material3.Chip.Assist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:chipIcon="@drawable/ic_pending"
                        app:chipIconSize="18dp"
                        tools:text="En revisión" />

                    <!-- Progress indicator for different states -->
                    <LinearLayout
                        android:id="@+id/progressLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_medium"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Step indicators -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <View
                                android:id="@+id/step1Indicator"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/circle_background"
                                android:backgroundTint="@color/primary" />

                            <TextView
                                style="@style/TextAppearance.HireLink.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_tiny"
                                android:text="Enviado"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_weight="1"
                            android:layout_marginBottom="16dp"
                            android:background="@color/divider" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <View
                                android:id="@+id/step2Indicator"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/circle_background"
                                android:backgroundTint="@color/secondary" />

                            <TextView
                                style="@style/TextAppearance.HireLink.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_tiny"
                                android:text="Revisión"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="2dp"
                            android:layout_weight="1"
                            android:layout_marginBottom="16dp"
                            android:background="@color/divider" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:gravity="center">

                            <View
                                android:id="@+id/step3Indicator"
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="@drawable/circle_background"
                                android:backgroundTint="@color/text_hint" />

                            <TextView
                                style="@style/TextAppearance.HireLink.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_tiny"
                                android:text="Resultado"
                                android:textColor="@color/text_secondary" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Job Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_medium"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_large">

                    <TextView
                        style="@style/TextAppearance.HireLink.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Información del Empleo"
                        android:textColor="@color/primary"
                        android:drawableStart="@drawable/ic_work"
                        android:drawableTint="@color/primary"
                        android:drawablePadding="@dimen/margin_small"
                        android:gravity="center_vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/margin_small"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:background="@color/divider" />

                    <!-- Job Details Chips -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/jobDetailsChipGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_medium"
                        app:chipSpacingHorizontal="@dimen/margin_small">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/modalityChip"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipIcon="@drawable/ic_modality"
                            app:chipIconSize="16dp"
                            tools:text="Remoto" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/employmentTypeChip"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipIcon="@drawable/ic_work_small"
                            app:chipIconSize="16dp"
                            tools:text="Tiempo completo" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/salaryChip"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipIcon="@drawable/ic_money"
                            app:chipIconSize="16dp"
                            tools:text="S/. 5000 - 7000" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/vacanciesChip"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipIcon="@drawable/ic_people"
                            app:chipIconSize="16dp"
                            tools:text="5 vacantes" />

                    </com.google.android.material.chip.ChipGroup>

                    <!-- Job Description -->
                    <TextView
                        style="@style/TextAppearance.HireLink.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Descripción del Empleo:"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="@dimen/margin_small" />

                    <TextView
                        android:id="@+id/jobDescription"
                        style="@style/TextAppearance.HireLink.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        tools:text="Buscamos un desarrollador Android con experiencia en Kotlin, arquitectura MVVM y desarrollo de aplicaciones nativas." />

                    <!-- Job Requirements -->
                    <TextView
                        style="@style/TextAppearance.HireLink.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Requisitos:"
                        android:textStyle="bold"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="@dimen/margin_small" />

                    <TextView
                        android:id="@+id/jobRequirements"
                        style="@style/TextAppearance.HireLink.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_primary"
                        tools:text="• 3+ años de experiencia en desarrollo Android\n• Conocimiento en Kotlin y Java\n• Experiencia con MVVM y LiveData\n• Conocimiento de APIs REST y bases de datos" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Contact Information Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_extra_large"
                app:cardCornerRadius="@dimen/radius_large"
                app:cardElevation="@dimen/card_elevation"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/margin_large">

                    <TextView
                        style="@style/TextAppearance.HireLink.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Información de Contacto"
                        android:textColor="@color/primary"
                        android:drawableStart="@drawable/ic_phone"
                        android:drawableTint="@color/primary"
                        android:drawablePadding="@dimen/margin_small"
                        android:gravity="center_vertical" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/margin_small"
                        android:layout_marginBottom="@dimen/margin_medium"
                        android:background="@color/divider" />

                    <!-- Phone -->
                    <LinearLayout
                        android:id="@+id/phoneLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/margin_small"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:padding="@dimen/margin_small">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/secondary" />

                        <TextView
                            android:id="@+id/companyPhone"
                            style="@style/TextAppearance.HireLink.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/blue_contact"
                            tools:text="+51 987654321" />

                    </LinearLayout>

                    <!-- Email -->
                    <LinearLayout
                        android:id="@+id/emailLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/margin_small"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:padding="@dimen/margin_small">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:src="@drawable/ic_email"
                            app:tint="@color/secondary" />

                        <TextView
                            android:id="@+id/companyEmail"
                            style="@style/TextAppearance.HireLink.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/blue_contact"
                            tools:text="rrhh@techsolutions.com" />

                    </LinearLayout>

                    <!-- Website -->
                    <LinearLayout
                        android:id="@+id/websiteLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground"
                        android:padding="@dimen/margin_small">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="@dimen/margin_small"
                            android:src="@drawable/ic_web"
                            app:tint="@color/secondary" />

                        <TextView
                            android:id="@+id/companyWebsite"
                            style="@style/TextAppearance.HireLink.Body"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/blue_contact"
                            tools:text="www.techsolutions.com" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/surface"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:padding="@dimen/margin_medium">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelApplicationButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/button_height"
            android:text="Cancelar Postulación"
            android:textSize="@dimen/text_size_medium"
            app:icon="@drawable/ic_close"
            app:iconGravity="textStart"
            app:strokeColor="@color/error"
            android:textColor="@color/error"
            app:cornerRadius="@dimen/radius_large" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>