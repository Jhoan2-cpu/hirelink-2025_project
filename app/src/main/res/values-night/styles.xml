<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text Styles - Dark Mode -->
    <style name="TextAppearance.HireLink.Headline" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_headline</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.HireLink.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.HireLink.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>

    <style name="TextAppearance.HireLink.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_size_small</item>
    </style>

    <!-- Bottom Navigation Style - Dark Mode -->
    <style name="Widget.HireLink.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="itemIconTint">@drawable/bottom_nav_color_selector</item>
        <item name="itemTextColor">@drawable/bottom_nav_color_selector</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.HireLink.BottomNavigationView.ActiveIndicator</item>
        <item name="itemRippleColor">@color/ripple</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.HireLink.BottomNav.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.HireLink.BottomNav.Inactive</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
        <item name="android:background">@color/bottom_nav_background</item>
    </style>

    <style name="TextAppearance.HireLink.BottomNav.Active" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/bottom_nav_selected</item>
    </style>

    <style name="TextAppearance.HireLink.BottomNav.Inactive" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/bottom_nav_unselected</item>
    </style>
</resources>