<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Shadow layer for depth -->
    <item android:top="3dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/shadow" />
        </shape>
    </item>
    
    <!-- Secondary shadow for more depth -->
    <item android:top="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#10000000" />
        </shape>
    </item>
    
    <!-- Main background with glassmorphism effect -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="@color/surface" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
        </shape>
    </item>
    
    <!-- Subtle inner highlight -->
    <item android:bottom="3dp" android:top="1dp" android:left="1dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="27dp" />
            <gradient
                android:startColor="#20FFFFFF"
                android:endColor="@android:color/transparent"
                android:angle="270"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Top accent gradient -->
    <item android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <gradient
                android:startColor="#15007FFF"
                android:endColor="@android:color/transparent"
                android:angle="270"
                android:type="linear" />
        </shape>
    </item>
    
</layer-list>